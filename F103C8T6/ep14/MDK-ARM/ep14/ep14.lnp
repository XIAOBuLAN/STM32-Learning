--cpu Cortex-M3
"ep14\startup_stm32f103xb.o"
"ep14\main.o"
"ep14\gpio.o"
"ep14\stm32f1xx_it.o"
"ep14\stm32f1xx_hal_msp.o"
"ep14\stm32f1xx_hal_gpio_ex.o"
"ep14\stm32f1xx_hal.o"
"ep14\stm32f1xx_hal_rcc.o"
"ep14\stm32f1xx_hal_rcc_ex.o"
"ep14\stm32f1xx_hal_gpio.o"
"ep14\stm32f1xx_hal_dma.o"
"ep14\stm32f1xx_hal_cortex.o"
"ep14\stm32f1xx_hal_pwr.o"
"ep14\stm32f1xx_hal_flash.o"
"ep14\stm32f1xx_hal_flash_ex.o"
"ep14\stm32f1xx_hal_exti.o"
"ep14\system_stm32f1xx.o"
--strict --scatter "ep14\ep14.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "ep14.map" -o ep14\ep14.axf