--cpu Cortex-M3
"ep11\startup_stm32f103xb.o"
"ep11\main.o"
"ep11\gpio.o"
"ep11\stm32f1xx_it.o"
"ep11\stm32f1xx_hal_msp.o"
"ep11\stm32f1xx_hal_gpio_ex.o"
"ep11\stm32f1xx_hal.o"
"ep11\stm32f1xx_hal_rcc.o"
"ep11\stm32f1xx_hal_rcc_ex.o"
"ep11\stm32f1xx_hal_gpio.o"
"ep11\stm32f1xx_hal_dma.o"
"ep11\stm32f1xx_hal_cortex.o"
"ep11\stm32f1xx_hal_pwr.o"
"ep11\stm32f1xx_hal_flash.o"
"ep11\stm32f1xx_hal_flash_ex.o"
"ep11\stm32f1xx_hal_exti.o"
"ep11\system_stm32f1xx.o"
--strict --scatter "ep11\ep11.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "ep11.map" -o ep11\ep11.axf